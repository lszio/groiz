</section>

<!-- ═══ Agent · 目录+详情(v1 单实体:loom 教学环) ═══ -->
<section class="view" data-view="agent" id="view-agent" hidden>
  <section class="block" style="padding-top:36px">
    <div class="wrap">
      <div class="agent-hero">
        <div class="agent-id">
          <h1>loom 教学环</h1>
          <p class="agent-desc">身份即程序:这个 Agent 的决策逻辑就是 agent.zio——审查它等于审查它。</p>
          <div class="caps">
            <span class="cap">complete</span><span class="cap">execute</span><span class="cap">extract</span>
            <span class="cap">revise</span><span class="cap">candidate?</span>
          </div>
        </div>
        <div class="state-col">
          <span class="badge" id="aState"><span class="dot" id="aDot"></span><span id="aStateText">connecting…</span></span>
        </div>
      </div>
      <div class="tabs" role="tablist">
        <button class="atab on" data-pane="p-over" role="tab" aria-selected="true">Overview</button>
        <button class="atab" data-pane="p-act" role="tab" aria-selected="false">Activity</button>
        <button class="atab" data-pane="p-task" role="tab" aria-selected="false">Tasks</button>
        <button class="atab" data-pane="p-cfg" role="tab" aria-selected="false">Configuration</button>
      </div>
