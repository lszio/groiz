---
import '../styles/zt-tokens.css';
import '../styles/global.css';
interface Props { title: string }
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="theme-color" content="#F5F7FA" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#10151D" media="(prefers-color-scheme: dark)">
  <script is:inline>
/* 主题引导:首帧前解析 system/light/dark 并写 data-theme,避免闪烁。
   偏好存 localStorage "zt-theme",与 loom 控制台共用同一键。 */
(function () {
  var p; try { p = localStorage.getItem('zt-theme'); } catch (e) {}
  if (p !== 'light' && p !== 'dark') p = 'system';
  var d = p === 'dark' ||
    (p === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
  document.documentElement.dataset.theme = d ? 'dark' : 'light';
  document.documentElement.dataset.themePref = p;
})();

    window.ztTheme = {
      order: ['system', 'light', 'dark'],
      glyph: { system: '\u25d0', light: '\u2600', dark: '\u263e' },
      label: { system: '跟随系统', light: '浅色', dark: '深色' },
      get() { return document.documentElement.dataset.themePref || 'system'; },
      apply(p) {
        var dd = p === 'dark' ||
          (p === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dd ? 'dark' : 'light';
        document.documentElement.dataset.themePref = p;
        var b = document.getElementById('themeBtn');
        if (b) {
          b.textContent = this.glyph[p];
          b.setAttribute('aria-label', '切换主题（当前：' + this.label[p] + '）');
          b.title = '主题：' + this.label[p];
        }
      },
      set(p) { try { localStorage.setItem('zt-theme', p); } catch (e) {} this.apply(p); },
      cycle() { this.set(this.order[(this.order.indexOf(this.get()) + 1) % 3]); },
    };
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
      if (ztTheme.get() === 'system') ztTheme.apply('system');
    });
  </script>
</head>
<body>
  <slot />
  <script is:inline>ztTheme.apply(ztTheme.get());</script>
  <script>
    import '../scripts/app.js';
  </script>
</body>
</html>
